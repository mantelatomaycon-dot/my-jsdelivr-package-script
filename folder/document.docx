<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<w:document xmlns:w="http://schemas.openxmlformats.org/wordprocessingml/2006/main">
  <w:body>

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Title"/>
      </w:pPr>
      <w:r>
        <w:t>SAMPLE DOCUMENT</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading1"/>
      </w:pPr>
      <w:r>
        <w:t>Introduction</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:r>
        <w:t>Hello! This is a sample Word document.</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>Name:</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> Sample Document</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>Type:</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> Microsoft Word Document</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>Extension:</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> .doc</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading2"/>
      </w:pPr>
      <w:r>
        <w:t>Information</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:r>
        <w:t>• This is an example.</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:r>
        <w:t>• It was created for testing.</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:r>
        <w:t>• The document contains formatted text.</w:t>
      </w:r>
    </w:p>

    <w:p>
      <w:r>
        <w:rPr><w:b/></w:rPr>
        <w:t>Thank you for reading!</w:t>
      </w:r>
    </w:p>

    <w:sectPr/>
  </w:body>
</w:document>
